<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>instanto-teavm-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>
  <groupId>io.instanto</groupId>
  <artifactId>teavm-charba-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Charba for TeaVM</name>
  <description>Charba for TeaVM: Java browser API and showcase</description>
  <url>https://github.com/instanto-io/teavm-charba</url>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <scm>
    <url>https://github.com/instanto-io/teavm-charba</url>
    <connection>scm:git:https://github.com/instanto-io/teavm-charba.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/instanto-io/teavm-charba.git</developerConnection>
    <tag>HEAD</tag>
  </scm>
  <!-- Snapshot publication is inherited from instanto-org-pom via instanto-teavm-pom. -->
  <properties>
    <compat.version>0.1.0-SNAPSHOT</compat.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-09-07T16:00:00Z</project.build.outputTimestamp>
    <gwt.version>2.13.1</gwt.version>
    <elemental2.version>1.2.3</elemental2.version>
    <elemental2.compat.version>1.2.3-SNAPSHOT</elemental2.compat.version>
    <jsinterop.annotations.version>2.0.2</jsinterop.annotations.version>
    <jsinterop.base.version>1.0.1</jsinterop.base.version>
    <teavm.optimization>SIMPLE</teavm.optimization>
    <gwt.style>PRETTY</gwt.style>
    <google-java-format.version>1.35.0</google-java-format.version>
    <junit.version>4.13.2</junit.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <teavm.junit.js.runner>browser-chrome</teavm.junit.js.runner>
  </properties>
  <modules>
    <module>charba-compat</module>
    <module>charba-demo</module>
  </modules>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <configuration>
              <doclint>none</doclint>
              <detectOfflineLinks>false</detectOfflineLinks>
              <additionalJOptions>
                <additionalJOption>--allow-script-in-comments</additionalJOption>
              </additionalJOptions>
            </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.43.0</version>
        <inherited>false</inherited>
        <configuration>
          <java>
            <includes>
              <include>*/src/main/java/**/*.java</include>
              <include>*/src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports />
          </java>
        </configuration>
        <executions>
          <execution>
            <id>format-java</id>
            <phase>validate</phase>
            <goals>
              <goal>apply</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Reporting, SARIF and HTML configuration are inherited from
           instanto-org-pom. Only the compatibility filter and the release gate
           belong to this repository. -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
        <executions>
          <execution>
            <id>high-priority-analysis-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <failThreshold>High</failThreshold>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <dependencyConvergence />
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>production</id>
      <properties>
        <teavm.optimization>ADVANCED</teavm.optimization>
        <gwt.style>OBF</gwt.style>
      </properties>
    </profile>
  </profiles>
</project>
